R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_BUCKET=audio-upload-files
CONSUMER_DOWNLOAD_ROOT=./runtime
CONSUMER_POLL_INTERVAL=10
CONSUMER_PLAYER_COMMAND=
CONSUMER_DRY_RUN=true

# LiveKit real-time one-way call receiver (required for the new default mode).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-me
# Optional raw-PCM player override. The default is ffplay at 48 kHz mono.
LIVEKIT_PCM_PLAYER_COMMAND=
